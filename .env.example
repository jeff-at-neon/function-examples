# Neon Blocks — local / CI test configuration
#
# Copy to .env and fill in. `.env` is gitignored; this file is not, so never put a real
# credential here.
#
#   cp .env.example .env
#   $EDITOR .env
#   node scripts/doctor.mjs        # validates everything below without printing secrets
#
# Only DATABASE_URL is needed to exercise the migrations, which is the biggest unverified
# area. Everything else unlocks progressively more blocks — see "What each section unlocks".

# ─────────────────────────────────────────────────────────────────────────────
# 1. Database — required. Unlocks all 25 migrations and every v_status view.
# ─────────────────────────────────────────────────────────────────────────────
#
# Use a THROWAWAY BRANCH, not production. The rollback verification drops schemas by design.
# Create one in the Neon console, or:
#
#   neon branches create --name blocks-test
#   neon connection-string blocks-test
#
# Pooled vs direct: use the DIRECT (non-pooled) string. Migrations run DDL and advisory locks,
# and PgBouncer in transaction mode does not hold session state across statements.
DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# 2. Object Storage — unlocks blocks 2, 4, 5, 9, 11, 15, 16, 18, 19, 23
# ─────────────────────────────────────────────────────────────────────────────
#
# Neon injects these automatically in a deployed function. Set them here only for local
# testing. Falls back to AWS_* names, so MinIO works for offline testing too.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_REGION=auto

# Buckets the storage blocks watch. Create these before running storage tests.
# IMPORTANT: the derivative/report buckets must differ from the source, or a written output
# retriggers the pipeline that produced it — forever. assertNoLoop() refuses to start if you
# get this wrong, which is deliberate: the failure mode is a runaway bill.
RAG_BUCKET=blocks-test-documents
REGISTRY_BUCKET=blocks-test-uploads
ROUTER_BUCKET=blocks-test-uploads
ROUTER_OUTPUT_BUCKET=blocks-test-derived
VISION_BUCKET=blocks-test-uploads
CSV_BUCKET=blocks-test-imports
IMAGES_SOURCE_BUCKET=blocks-test-uploads
IMAGES_DERIVATIVE_BUCKET=blocks-test-derived

# ─────────────────────────────────────────────────────────────────────────────
# 3. AI Gateway — unlocks blocks 2, 7, 9, 14, 16, 19, 20, 21
# ─────────────────────────────────────────────────────────────────────────────
#
# Also auto-injected in a deployed function. Any OpenAI-compatible endpoint works via the
# OPENAI_* fallbacks, which is useful for testing against a local model.
NEON_AI_GATEWAY_URL=
NEON_AI_GATEWAY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 4. Trigger authentication — strongly recommended
# ─────────────────────────────────────────────────────────────────────────────
#
# Neon does NOT sign trigger delivery. X-Neon-Trigger-Invocation-Id is identification, not
# authentication, so anyone who learns a function URL can forge an event. This shared secret
# is the only way to actually authenticate one.
#
# Generate: openssl rand -base64 32
# Then append ?secret=<value> to each trigger's function_path.
NEON_BLOCKS_TRIGGER_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 5. Webhook signing secrets — unlocks block 6 (inbound webhooks)
# ─────────────────────────────────────────────────────────────────────────────
#
# Only set the providers you actually want to test. A provider with no configured secret is
# refused rather than accepted unverified, which is the safe direction.
WEBHOOK_SECRET_STRIPE=
WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_SHOPIFY=
WEBHOOK_SECRET_SLACK=
WEBHOOK_SECRET_CLERK=

# ─────────────────────────────────────────────────────────────────────────────
# 6. Deployment — for `neon function deploy` and trigger creation
# ─────────────────────────────────────────────────────────────────────────────
#
# Needed only to deploy functions, not to test migrations. Create at:
#   https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH=blocks-test

# ─────────────────────────────────────────────────────────────────────────────
# 7. Block 15 (pii-anonymizer) safety interlock
# ─────────────────────────────────────────────────────────────────────────────
#
# Masking is irreversible, so the block refuses to run unless the branch name matches this
# pattern. Keep it restrictive — the failure mode is destroying real customer data.
ANONYMIZE_SALT=
ANONYMIZE_ALLOW_BRANCH_PATTERN=^(blocks-test|dev|preview|staging)

# ─────────────────────────────────────────────────────────────────────────────
# What each section unlocks
# ─────────────────────────────────────────────────────────────────────────────
#
#   Section 1 only        all 25 migrations + rollback verification + every v_status view.
#                         This is the highest-value step: it is the part that has never run.
#   + Section 3           RAG ingestion, hybrid search, vision, embedding freshness
#   + Section 2           the whole storage family end to end
#   + Sections 4-6        function deployment and live trigger delivery
